{
  "$schema": "https://unpkg.com/knip@6.41.0/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route}.{ts,tsx}",
    "src/proxy.ts",
    "src/lib/*.test.ts",
    "scripts/**/*.{mjs,ts,js}",
    "e2e/**/*.ts",
    "*.config.{ts,mjs,js}"
  ],
  "project": [
    "src/**/*.{ts,tsx,js}",
    "scripts/**/*.{mjs,ts,js}",
    "e2e/**/*.ts",
    "*.config.{ts,mjs,js}"
  ],
  "ignore": [
    ".worktrees/**", ".next/**", ".codex-tmp/**",
    "output/**", "artifacts/**", ".superpowers/**"
  ],
  "next": {
    "entry": [
      "src/app/**/{page,layout,loading,error,not-found,route}.{ts,tsx}",
      "src/proxy.ts"
    ]
  }
}
