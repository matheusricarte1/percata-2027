    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "next": "^16.2.6",
    "nodemailer": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-virtuoso": "^4.18.5",
    "recharts": "^3.8.1",
