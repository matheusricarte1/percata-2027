    "db:load-dbatualizado:efisco": "node scripts/load-dbatualizado-efisco.mjs",
    "db:apply-dbatualizado:efisco": "node scripts/apply-dbatualizado-efisco.mjs",
    "db:check-grants": "node scripts/check-supabase-grants.mjs",
